# 조회 서버(RSP)의 paperdb를 가리킨다. 이 프로세스는 RSP API를 호출하지 않는다.
# 호스트에서 RSP compose가 5433으로 열어 둔 경우:
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=paperdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
EMBEDDING_MODEL=all-MiniLM-L6-v2

# 같은 Docker 네트워크의 postgres 서비스에 붙을 때는
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
